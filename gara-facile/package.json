{
  "name": "gara-facile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/check-migrations.mjs",
    "test:files": "tsx --test app/services/files/*.test.ts",
    "test:ai": "tsx --test app/services/ai/*.test.ts",
    "test:files:http": "node scripts/check-files-http.mjs",
    "test:profiles": "tsx --test app/services/business/*.test.ts",
    "test:match": "tsx --test app/services/match/*.test.ts",
    "test:ai": "tsx --test app/services/ai/*.test.ts",
    "ai:extract-fixtures": "tsx --env-file=.env scripts/extract-fixtures.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.2.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
