# Configure a new SQLite database, then run `bun run db:generate` and `bun run db:migrate`.
DB_FILE_NAME=./sqlite.db

# TED contract fetching. Not required to complete the business profile form.
EU_API_KEY=

# Optional operator/server-to-server token, at least 32 random characters.
# The browser form uses its own private profile session and does not need it.
# Never expose this as NEXT_PUBLIC_* or embed it in the browser.
FILES_API_TOKEN=

# New uploads use local or s3. Existing documents retain their provider/bucket.
FILES_STORAGE_PROVIDER=local
FILES_LOCAL_DIR=./var/uploads

# S3 or compatible buckets (e.g. R2 or MinIO). Buckets must already exist.
FILES_S3_BUCKET=
FILES_S3_REGION=us-east-1
FILES_S3_ENDPOINT=
FILES_S3_FORCE_PATH_STYLE=false
# Leave both blank to use the AWS SDK default credential chain / IAM role.
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=

# Evolus (server-only, never NEXT_PUBLIC_*). APP_ID is the workspace SPACE ID (X-Application-Id).
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_LIBRARY_ID=
# Optional override; default https://api.evolus.ai/v1
EVOLUS_BASE_URL=

# AI inference: any OpenAI-compatible endpoint on AMD GPUs (base URL ends in /v1).
# Default: AMD Token Factory (team key rc-..., 20 RPM and a daily cap shared by the team).
# Gemma (Google) serves both roles; any OpenAI-compatible model can be swapped in.
LLM_EXTRACT_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_EXTRACT_MODEL=Gemma-4-31B-IT
LLM_EXTRACT_API_KEY=
# Only for thinking models (e.g. "low"); Gemma does not think by default.
LLM_EXTRACT_REASONING_EFFORT=
LLM_DRAFT_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_DRAFT_MODEL=Gemma-4-31B-IT
LLM_DRAFT_API_KEY=
LLM_DRAFT_REASONING_EFFORT=
# Per-request timeout in ms (default 120000).
LLM_TIMEOUT_MS=
AMD_GPU_LABEL=AMD Radeon Cloud · Token Factory
